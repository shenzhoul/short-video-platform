# =============================================================================
# R2 STAGING verification — template
# =============================================================================
# Copy to `.env.r2-staging.local` (git-ignored) and fill in the STAGING token:
#
#   cp file-server/.env.r2-staging.local.example file-server/.env.r2-staging.local
#   # then open it in VS Code and paste the values
#
#   cd file-server
#   yarn build
#   yarn verify:r2
#
# `verify:r2` loads THIS file and does NOT load `file-server/.env`. That
# isolation is deliberate: `.env` is the local development config (disk storage,
# local Mongo), and it is also the file most likely to acquire a production
# token later. This script uploads and deletes objects, so it must never be one
# careless edit away from writing to the production bucket.
#
# ## The token that belongs here
#
# The **staging** R2 API token — Object Read & Write, scoped to
# douyin-media-staging and nothing else.
#
# The PRODUCTION token does not go in this file, ever. It belongs only in
# `deploy/.env` on the VM. See docs/deployment/README.md §2.
#
# Nothing here is passed on the command line, so no value reaches shell history
# or the process table.

# --- required ---------------------------------------------------------------

# The account's own S3 endpoint: https://<account id>.r2.cloudflarestorage.com
# Cloudflare dashboard -> R2 -> Overview -> "S3 API" for the bucket.
# Never the AWS global endpoint; there is no default, on purpose.
R2_ENDPOINT=

# Not a secret — pinned so a mistyped endpoint cannot silently retarget this.
# The script REFUSES to run against a bucket whose name matches /prod/i.
R2_BUCKET_NAME=douyin-media-staging

# Cloudflare -> R2 -> Manage API Tokens -> the STAGING token.
# The secret is shown exactly once at creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- optional ---------------------------------------------------------------

# Read by src/config/storage.ts. Not needed for this run; fill it if you like.
R2_ACCOUNT_ID=

# R2 has one region and it is spelled `auto`.
R2_REGION=auto

# Leave EMPTY for step B.
#
# The staging Worker is not deployed yet, and with no public base URL the script
# falls back to presigned GETs — which still proves upload, HEAD, GET, Range/206
# and delete against the real bucket. Set it later, after the staging Worker
# exists, to verify public delivery through workers.dev as well.
R2_PUBLIC_BASE_URL=

# Namespaces keys within the bucket. The verification run already isolates
# itself under `_verify/<run id>`, so this can stay empty.
R2_KEY_PREFIX=

# Defaults are fine; listed so the run is reproducible.
STORAGE_CACHE_CONTROL=public, max-age=31536000, immutable
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# Only for verifying against a non-Cloudflare S3-compatible provider. Leave unset.
# R2_ALLOW_NON_R2_ENDPOINT=

# MUST STAY UNSET. Setting it disables the refusal to run against a
# production-looking bucket, and this script deletes objects.
# R2_VERIFY_ALLOW_PRODUCTION_BUCKET=
