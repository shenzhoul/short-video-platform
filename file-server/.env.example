NODE_ENV=development
HTTP_PORT=8000
HOST=localhost

BASE_URL=http://localhost:8000

JWT_SECRET=
API_SECRET_KEY=
INTERNAL_API_KEY=

MONGO_URI=mongodb://localhost:27017/douyin-clone-file-server

REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=1
REDIS_QUEUE_USERNAME=
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_TLS=false

LOGGER_MONGO_URI=mongodb://localhost:27017/douyin-clone-logger
# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Where NEW uploads go. `disk` keeps bytes under file-server/public and serves
# them with ServeStaticModule — this is what local development uses and it must
# stay the default. `r2` puts objects in a Cloudflare R2 bucket.
#
# Switching this does NOT move or re-address existing media: every file record
# stores its own storageType and reads dispatch on that, so disk-era files keep
# resolving to disk after a cutover.
STORAGE_DRIVER=disk

# --- Cloudflare R2 (only read when STORAGE_DRIVER=r2) ----------------------
# Dashboard: Cloudflare -> R2 -> Overview.
#
# Create TWO buckets, not one: `douyin-clone-staging` and `douyin-clone-prod`.
# If that is impossible, keep one bucket and set a different R2_KEY_PREFIX per
# environment — but separate buckets are what makes a staging mistake harmless.
#
# The API token: R2 -> Manage API Tokens -> Create API Token, permission
# "Object Read & Write", scoped to the one bucket. It shows the Access Key ID
# and Secret Access Key exactly once. Never reuse the same token between
# staging and production.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The account's own S3 endpoint: https://<account id>.r2.cloudflarestorage.com
# Required, with no default — every plausible default resolves to real AWS, and
# these credentials would be sent there.
R2_ENDPOINT=

# The origin browsers fetch media from. Bind a custom domain to the bucket
# (R2 -> your bucket -> Settings -> Public access -> Custom Domains) and put it
# here, e.g. https://cdn.example.com.
#
# Do NOT use the *.r2.dev development URL in production: it is rate-limited and
# Cloudflare documents it as non-production. R2 answers Range requests on this
# origin itself, which is what makes video seeking work without the file server
# in the data path.
R2_PUBLIC_BASE_URL=

# R2 has exactly one region and it is spelled `auto`.
R2_REGION=auto

# Namespaces every key this deployment writes. The fallback boundary when
# staging and production must share a bucket. Leave empty when they do not.
R2_KEY_PREFIX=

# Cache-Control written onto uploaded objects. Keys carry an ObjectId and a UUID
# and are never rewritten in place, so objects are immutable and safe to cache
# for a year.
STORAGE_CACHE_CONTROL=public, max-age=31536000, immutable

# Lifetime of a presigned GET for a non-public object.
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Production hardening
# ---------------------------------------------------------------------------
# Exact origins allowed to call this service, comma-separated. REQUIRED when
# NODE_ENV=production — the service refuses to start without it, because a
# wildcard with credentials is rejected by browsers rather than honoured, which
# would break every upload instead of loosening anything.
# e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=
