NODE_ENV=development
HTTP_PORT=8080

MONGO_URI=mongodb://localhost/douyin-clone

BASE_URL=http://localhost:8080
BASE_URL_WEBHOOK_INTERNAL=http://localhost:8080

REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=0
REDIS_QUEUE_USERNAME=
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_TLS=false

# Project namespace for every Redis key this app writes. The development Redis is
# shared with another project, so a bare key names no owner. Changing this is a
# cutover, not a migration: sessions, cache and presence start empty.
REDIS_NAMESPACE=douyin-clone

LOGGER_MONGO_URI=mongodb://localhost:27017/douyin-clone-logger

FILE_SERVER_BASE_URL=http://localhost:8000

# Generate a strong random secret locally.
FILE_SERVER_API_KEY=
FILE_SERVER_JWT_SECRET=
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Transactional email (verification + password reset)
# ---------------------------------------------------------------------------
# 'smtp' delivers for real. 'log' prints the message to the server console and
# sends nothing, which is what local development uses so no Gmail account is
# needed. The API refuses to start with 'log' when NODE_ENV=production.
MAIL_PROVIDER=log

# The canonical origin of the user web app. EVERY emailed link is built from
# this and nothing else -- never from a request's Host/Origin header, which is
# attacker-controlled. Required in every environment; must be https in
# production. In production this is the one canonical URL, not a preview
# deployment's URL.
USER_APP_URL=http://localhost:8081

# Gmail submission. Use a Gmail account dedicated to this project, turn on
# 2-Step Verification, and create an App Password:
#   https://support.google.com/accounts/answer/185833
# Leave these blank while MAIL_PROVIDER=log. Never commit a real value, and
# never set them on the Vercel projects -- only the API host reads them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 465 is implicit TLS (SMTP_SECURE=true); 587 is STARTTLS (SMTP_SECURE=false).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Douyin Clone
MAIL_FROM_ADDRESS=

# Token lifetimes. A reset token is the more dangerous of the two and is acted
# on immediately; a confirmation link is often opened the next morning.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Development convenience: print the full link (token included) to the console
# so it can be clicked. Ignored when NODE_ENV=production. Off by default,
# because a raw token in a log file is a live credential in a log file.
MAIL_LOG_REVEAL_LINKS=false

# ---------------------------------------------------------------------------
# Stock media providers (Pexels / Pixabay)
# ---------------------------------------------------------------------------
# Server-side only. These are outbound third-party credentials and must never be
# exposed to the browser -- do not copy them into user/ or admin/ under a
# NEXT_PUBLIC_ name, and never set them on the Vercel projects. Only the API
# host reads them.
#
# Read only by `yarn demo:fetch-media`, which downloads the media for the demo
# dataset. `yarn demo:seed` never reads them -- see docs/features/demo-dataset.md.
#
# Obtain the keys:
#   Pexels  -- https://www.pexels.com/api/  (sign in, "Your API Key")
#   Pixabay -- https://pixabay.com/api/docs/ (sign in, key shown in the docs page)
#
# Pexels is the primary source. Pixabay is only consulted for media Pexels
# could not supply, so leaving it blank makes the fetch stricter, not broken.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------------------------------------------------------------------------
# Production hardening
# ---------------------------------------------------------------------------
# Exact origins allowed to call the API, comma-separated. REQUIRED when
# NODE_ENV=production — the API refuses to start without it. A wildcard with
# `credentials: true` is rejected by browsers rather than honoured, so the
# fallback would break every authenticated request instead of loosening
# anything. Locally this is unset and unnecessary, because the web apps reach
# the API through their own Next rewrite and are same-origin.
# e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=

# Behind a reverse proxy (nginx, Cloudflare) the socket peer is the proxy, so
# every rate limit and every IP-bound signed URL would key on one address.
# Set TRUST_PROXY_HEADERS=true only when the app is genuinely behind a proxy
# you control — with it on, a direct caller can forge X-Forwarded-For.
# Prefer TRUSTED_PROXY_IPS: the header is honoured only from those addresses.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# ---------------------------------------------------------------------------
# Demo dataset safety
# ---------------------------------------------------------------------------
# `yarn demo:seed` and `yarn demo:clean` take their target from MONGO_URI, so
# the command that seeds a laptop and the command that rewrites production are
# identical text. Both refuse to run when the target looks like production
# (NODE_ENV=production, or a MONGO_URI host that is not localhost).
#
# These belong on the command line for one invocation, NOT in this file:
#   ALLOW_PRODUCTION_DEMO_SEED=true yarn demo:seed
#   ALLOW_PRODUCTION_DEMO_CLEAN=true yarn demo:clean --confirm-production
#
# Cleaning additionally forces --dry-run unless --confirm-production is passed,
# so a mistyped command prints the deletion plan and deletes nothing.
ALLOW_PRODUCTION_DEMO_SEED=false
ALLOW_PRODUCTION_DEMO_CLEAN=false
