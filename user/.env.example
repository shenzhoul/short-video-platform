API_SERVER_ENDPOINT=http://localhost:8080
NEXT_PUBLIC_API_ENDPOINT=http://localhost:8080

SITE_URL=http://localhost:8081
NEXT_PUBLIC_SITE_URL=http://localhost:8081

NEXTAUTH_URL=http://localhost:8081
NEXTAUTH_URL_INTERNAL=http://localhost:8081

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

PROXY_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# Production (Vercel project settings -> Environment Variables)
# ---------------------------------------------------------------------------
# In production these all become https URLs on real domains. Two of them are
# NOT interchangeable and getting them the wrong way round is the classic
# mistake:
#
#   API_SERVER_ENDPOINT      server-side only. On the hybrid deployment this is
#                            the API's public https origin, because Vercel's
#                            functions reach the VPS over the internet — there
#                            is no private network between them.
#   NEXT_PUBLIC_API_ENDPOINT baked into the browser bundle. Public by
#                            definition; never put a secret in a NEXT_PUBLIC_*.
#
# PROXY_API_TARGET is what the Next rewrite forwards /api/* to. Keeping it
# pointed at the API origin is what keeps the browser same-origin with the API
# and avoids CORS on the hot path.
#
# Media URLs are NOT configured here: they come back from the API already
# absolute, built from R2_PUBLIC_BASE_URL on the file server. If media 404s in
# production, that variable is what is wrong, not anything in this file.
