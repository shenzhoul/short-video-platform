# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

agent

/.augment
*.tsbuildinfo

dump.rdb

# Docker bind mount data directories
# Ignore all contents but keep folder structure via .gitkeep
data/*
data/**/*
!data/**/
!data/**/.gitkeep
backups/

# Generated docs bundle (make doc-bundle)
docs/_generated/

# Ops secrets — NEVER commit (see scripts/ops/README.md)
scripts/ops/backup.env
scripts/ops/**/*.local
!scripts/ops/fail2ban/jail.local
*.age
age-key*.txt
*backup-key*.txt

# Environment & secrets
.env
.env.*
!.env.example
!.env.*.example

# Next.js / build caches
.next/
**/.next/
*.tsbuildinfo

# Local IDE
.vscode/

# Local/public-preparation artifacts
artifacts/

# Browser-automation artifacts. `output/screenshots/` is the single fixed
# screenshot folder used by the webapp-testing and playwright skills.
/output/

# AI / local development metadata
#
# `.agents/` is TRACKED on purpose: the rules, checklists and skills are part of how this repo is
# worked on, and they must survive a fresh clone.
#
# `.claude/` is a junction/symlink pointing at `.agents/` (see AGENTS.md). It must stay ignored —
# tracking it would commit every agent file a second time under a different path.
.claude/
.code-review-graph/
.cursor/

# Python bytecode produced by running the bundled skill scripts.
__pycache__/
*.pyc

# Issue tracker: unfixed defects, security suspicions and their reproduction steps.
# Deliberately NOT published — this repository has a public remote.
.agents/bug-tracker/
# MCP server config: contains machine-specific absolute paths (interpreter, repo root).
# Regenerate locally, see .agents/rules/shared.md.
.mcp.json

# Logs / caches
*.log
coverage/
.cache/