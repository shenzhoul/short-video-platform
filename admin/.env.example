API_SERVER_ENDPOINT=http://localhost:8080
NEXT_PUBLIC_API_ENDPOINT=http://localhost:8080

NEXTAUTH_URL=http://localhost:8082

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

PROXY_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# Production (deploy/.env on the VM -> compose build args, see deploy/)
# ---------------------------------------------------------------------------
# Same split as the user app: API_SERVER_ENDPOINT is server-side, and
# NEXT_PUBLIC_API_ENDPOINT is compiled into the browser bundle and therefore
# public. NEXTAUTH_URL must be the admin app's own https origin — an admin
# session issued against the wrong origin silently fails to persist.
#
# The admin origin must also appear in the API's CORS_ORIGIN list, or every
# admin request fails with an opaque CORS error rather than a 401.
