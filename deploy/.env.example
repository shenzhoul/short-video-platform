# =============================================================================
# Stack configuration for deploy/docker-compose.yml  (douyin-prod-01, GCE)
# =============================================================================
# Copy to `deploy/.env` ON THE VM and fill in:
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env          # required: it holds every backend secret
#
# `deploy/.env` is git-ignored. Never commit it, never paste its contents into
# a chat or an issue.
#
# Read by Compose itself (for ${...} substitution) and by both services through
# `env_file`, so it is the union of what they need. Mongo and Redis connection
# strings are NOT here — Compose sets them per service to in-network hostnames,
# because a copied-in `localhost` URI would resolve to the container itself.
#
# Generate every secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   # or, on the VM:  openssl rand -base64 32 | tr -d '=+/' | cut -c1-43
#
# Staging and production must NOT share a single secret.

# ----------------------------------------------------------------- stack shape
COMPOSE_PROJECT_NAME=douyin-clone

# Loopback ports the host nginx proxies to. Not public.
API_HOST_PORT=8080
FILE_SERVER_HOST_PORT=8000
# Loopback ports for the two Next containers. Never published publicly.
USER_HOST_PORT=8081
ADMIN_HOST_PORT=8082

# ------------------------------------------------------------------ datastores
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=douyin-clone
MONGO_BACKUP_DIR=./backups/mongodb

REDIS_PASSWORD=

# Namespaces every Redis key this app writes.
REDIS_NAMESPACE=douyin-clone

# --------------------------------------------------------------------- domains
# Replace __VM_IP__ with the VM's static IPv4 (dots). sslip.io resolves
# <anything>.<ip>.sslip.io to that IP with no DNS account and no cost.
#
# Both web apps run on THIS VM as containers behind nginx, so their origins are
# known up front — they are just two more sslip.io names pointing at the same IP.

# Canonical origin of the user web app. EVERY emailed link is built from this
# and nothing else, never from a request header. Must be https in production;
# the API refuses to start otherwise.
USER_APP_URL=https://app.__VM_IP__.sslip.io

# Canonical origin of the admin web app.
ADMIN_APP_URL=https://admin.__VM_IP__.sslip.io

# Public origin of this API.
BASE_URL=https://api.__VM_IP__.sslip.io
BASE_URL_WEBHOOK_INTERNAL=http://api:8080

# Public origin of the FILE SERVER — a different hostname to the API.
#
# Compose passes this to the file-server container as its own BASE_URL,
# overriding the one above. It has to: `tus-auth.service.ts` builds the
# resumable-upload URL handed back to browsers from BASE_URL, so if the file
# server inherited the API's value every TUS upload would be posted to
# api.<host>, which nginx routes to a service that has no TUS endpoint and a
# 10m body cap.
FILE_SERVER_PUBLIC_URL=https://files.__VM_IP__.sslip.io

# Exact origins allowed to call the backends, comma-separated. BOTH SERVICES
# REFUSE TO START in production without this. A wildcard with credentials is
# rejected by browsers rather than honoured, so the fallback would break every
# authenticated request instead of loosening anything.
CORS_ORIGIN=https://app.__VM_IP__.sslip.io,https://admin.__VM_IP__.sslip.io

# ---------------------------------------------------------------------- secrets
# api -> file-server call authentication. The SAME value must be set for both
# services; they are compared, not derived.
FILE_SERVER_API_KEY=
# api side of the upload-token signature.
FILE_SERVER_JWT_SECRET=
# Second factor on /internal/files. Same value in both services.
INTERNAL_API_KEY=
# file-server: signs upload tokens and signed file URLs. No fallback — signing
# fails closed rather than using a default key.
JWT_SECRET=
# NOTE: there is deliberately no API_SECRET_KEY here.
#
# The file server's InternalApiGuard compares the X-API-Key header against
# API_SECRET_KEY, and every caller sends FILE_SERVER_API_KEY in that header —
# they are one shared secret under two names. docker-compose.yml now derives
# API_SECRET_KEY from FILE_SERVER_API_KEY, so generating a second value here
# would be silently overridden at best, and at worst reintroduce the 401 that
# this note exists to prevent.

# The superadmin login created by the `create-admin-account` migration.
#
# REQUIRED before `yarn migrate` runs with NODE_ENV=production — the migration
# refuses to proceed without it, and writes nothing. The development fallback it
# would otherwise use is a literal committed to this public repository, so
# falling back would put a publicly-known password on a publicly-reachable admin
# panel.
#
# Generate it like the others. The migration never prints it.
#
# Rotating it AFTER the first deployment needs more than an edit here: the
# migration that creates the account is recorded as applied and never re-runs,
# and nothing else reads this variable at runtime. Run
# `node scripts/rotate-superadmin-password.js` inside the api container.
SUPERADMIN_PASSWORD=

# Shared password for the sixteen seeded demo accounts in this environment.
#
# NOT the value in `api/demo/demo.config.js`. That one is a local fixture
# committed to a public repository, so it is a password in name only —
# production must not use it, and `scripts/rotate-demo-passwords.js` refuses it.
#
# Read only by that rotation script; nothing uses it at runtime. Setting it here
# does not change already-seeded accounts on its own — run the script.
DEMO_ACCOUNT_PASSWORD=

# --------------------------------------------------------------- object storage
#
# >>> THE PRODUCTION R2 TOKEN GOES HERE, AND ONLY HERE. <<<
#
# It is an Object Read & Write token scoped to douyin-media-production. It must
# never appear in: the user or admin app, any NEXT_PUBLIC_* variable, the
# Cloudflare Worker (which uses a binding, not a key), or anything the browser
# can read.
#
# The STAGING token belongs in a separate local env used only by
# `yarn verify:r2` against douyin-media-staging. Do not put it in this file.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=douyin-media-production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The account's own S3 endpoint: https://<account id>.r2.cloudflarestorage.com
# Required, with no default — every plausible default resolves to real AWS, and
# these credentials would be sent there.
R2_ENDPOINT=

# The PUBLIC media origin: the Cloudflare Worker on workers.dev, e.g.
#   https://douyin-media.<your-subdomain>.workers.dev
#
# NOT the r2.dev URL (disabled, and documented by Cloudflare as rate-limited and
# development-only) and NOT the S3 endpoint above — that one is the management
# API and requires credentials, so using it here would either 401 for every
# visitor or leak a signature into page HTML.
#
# The Worker reads the bucket through a binding, so no key is involved in
# delivery. It answers Range/206, which is what makes video seeking work.
R2_PUBLIC_BASE_URL=

R2_REGION=auto

# Namespaces keys within the bucket. The buckets are already separate per
# environment, so this stays empty for production.
R2_KEY_PREFIX=

STORAGE_CACHE_CONTROL=public, max-age=31536000, immutable
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# ---------------------------------------------- media processing on 2 vCPU/4GB
# Transcode concurrency is already 1 (the processing workers subscribe without a
# `concurrency` option and BullMQ defaults to 1). These bound the inline
# validation path, which is what TUS completions fan out into. One 720p
# transcode was measured at ~392 MB peak; two do not fit beside MongoDB here.
# Also set in docker-compose.yml — kept here so the value is documented where
# an operator looks for it.
VIDEO_PROBE_CONCURRENCY=1
IMAGE_VALIDATION_CONCURRENCY=1

# ------------------------------------------------------------------------ mail
# The API refuses to start with MAIL_PROVIDER=log when NODE_ENV=production.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Douyin Clone
MAIL_FROM_ADDRESS=

# -------------------------------------------------------------------- operations
LOG_LEVELS=error,warn,log

# Behind host nginx. Without this every rate limit keys on the proxy's address
# and throttles all users as one.
TRUST_PROXY_HEADERS=true

# Left false. Type them on the command line for one invocation:
#   ALLOW_PRODUCTION_DEMO_SEED=true yarn demo:seed
ALLOW_PRODUCTION_DEMO_SEED=false
ALLOW_PRODUCTION_DEMO_CLEAN=false

# ------------------------------------------------------------------ front ends
# next-auth session signing keys, one per origin. A single value shared by both
# would let a session minted for the user app be presented to the admin app.
#
# Generate each separately and never echo them:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# These are RUNTIME variables, not build args: NEXTAUTH_SECRET was removed from
# user/next.config.js's env: block so it is a genuine runtime lookup. It is
# not baked into either image, and rotating it is a container restart rather
# than a rebuild.
USER_NEXTAUTH_SECRET=
ADMIN_NEXTAUTH_SECRET=
